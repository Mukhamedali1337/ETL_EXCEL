<%- include("partials/header", { title: "Свободная загрузка", heading: "Свободная загрузка Excel" }) %>

<% if (error) { %>
  <div class="alert alert-error" style="margin-bottom:20px;"><%= error %></div>
<% } %>
<% if (success) { %>
  <div class="alert alert-success" style="margin-bottom:20px;"><%= success %></div>
<% } %>

<% if (typeof skippedRows !== 'undefined' && skippedRows && skippedRows.length > 0) { %>
  <section class="card" style="margin-bottom:20px;">
    <h2>Пропущенные строки (<%= skippedRows.length %>)</h2>
    <p class="muted" style="margin-bottom:12px;">Эти строки не были вставлены — они уже существуют в таблице или являются дублями внутри файла.</p>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Строка</th>
            <th>Причина</th>
            <th>Данные</th>
          </tr>
        </thead>
        <tbody>
          <% skippedRows.forEach(row => { %>
            <tr>
              <td><%= row.rowNumber %></td>
              <td><%= row.reason %></td>
              <td class="muted" style="font-size:0.9em;"><%= row.preview %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
<% } %>

<% if (!freePreview) { %>

  <section class="hero-grid">
    <div class="card">
      <h2>Как это работает</h2>
      <ul class="check-list">
        <li>Загрузите любой Excel-файл (.xlsx или .xls)</li>
        <li>Имя файла станет именем таблицы в базе данных</li>
        <li>Заголовки колонок станут именами столбцов</li>
        <li>Система автоматически определит типы данных</li>
        <li>Вы можете скорректировать типы перед импортом</li>
        <li>Если таблица уже существует — выберите режим: добавить, заменить или обновить</li>
      </ul>
    </div>

    <div class="card accent-card">
      <h2>Загрузить файл</h2>
      <form method="post" action="/free-upload" enctype="multipart/form-data" class="form-stack">
        <input type="file" name="excelFile" id="excelFileInput" accept=".xlsx,.xls" required style="display:none" />
        <label>Excel-файл</label>
        <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
          <button type="button" id="chooseFileBtn" class="ghost-button" style="padding:8px 16px;">Выбрать файл</button>
          <span id="excelFileName" class="muted">Файл не выбран</span>
        </div>
        <button class="primary-button" type="submit">Проверить файл</button>
      </form>
    </div>
  </section>

  <% if (typeof freeTables !== 'undefined' && freeTables && freeTables.length > 0) { %>
    <section class="card" style="margin-top:20px;">
      <h2>Существующие таблицы</h2>
      <p class="muted" style="margin-bottom:12px;">Таблицы, созданные через свободную загрузку.</p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Таблица</th>
              <th style="text-align:right;">Строк</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% freeTables.forEach(tbl => { %>
              <tr>
                <td><code><%= tbl.name %></code></td>
                <td style="text-align:right;"><%= Number(tbl.row_count).toLocaleString("ru-RU") %></td>
                <td style="text-align:right;">
                  <% if (isAdmin) { %>
                  <form method="post" action="/free-drop" style="display:inline;" onsubmit="return confirm('Удалить таблицу <%= tbl.name %>?\nВсе данные будут потеряны — это действие необратимо.')">
                    <input type="hidden" name="tableName" value="<%= tbl.name %>" />
                    <button type="submit" class="ghost-button" style="color:#c0392b; border-color:#c0392b; padding:4px 10px; font-size:0.85em;">Удалить таблицу</button>
                  </form>
                  <% } else { %>
                  <form method="post" action="/free-drop" style="display:inline;" onsubmit="return confirm('Удалить ваши строки из таблицы <%= tbl.name %>?')">
                    <input type="hidden" name="tableName" value="<%= tbl.name %>" />
                    <button type="submit" class="ghost-button" style="color:#e67e22; border-color:#e67e22; padding:4px 10px; font-size:0.85em;">Удалить мои строки</button>
                  </form>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>
  <% } %>

<% } else { %>

  <section class="card" style="margin-bottom:20px;">
    <div class="stats-grid">
      <div class="stat-box">
        <strong><%= freePreview.originalFileName %></strong>
        <span>Файл</span>
      </div>
      <div class="stat-box">
        <strong><%= freePreview.totalRows %></strong>
        <span>Строк</span>
      </div>
      <div class="stat-box">
        <strong><%= freePreview.columns.length %></strong>
        <span>Колонок</span>
      </div>
    </div>
  </section>

  <form method="post" action="/free-import">
    <div class="hero-grid" style="margin-bottom:20px;">
      <section class="card">
        <h2>Имя таблицы</h2>
        <p class="muted" style="margin-bottom:12px;">По умолчанию — имя файла. Можно изменить.</p>
        <div style="display:flex; align-items:stretch;">
          <span style="display:flex; align-items:center; padding:0 10px; background:var(--bg-alt,#f4f4f4); border:1px solid var(--border,#ccc); border-right:none; border-radius:6px 0 0 6px; font-family:monospace; font-size:0.95em; color:var(--muted); white-space:nowrap;">free_</span>
          <input
            type="text"
            name="tableNameSuffix"
            value="<%= freePreview.tableName %>"
            required
            style="border-radius:0 6px 6px 0; flex:1;"
          />
        </div>
        <p class="muted" style="margin-top:6px; font-size:0.85em;">Итоговое имя в БД: <code id="tableNamePreview">free_<%= freePreview.tableName %></code></p>
      </section>

      <section class="card accent-card">
        <h2>Справка по типам данных</h2>
        <div class="table-wrap" style="margin-top:8px;">
          <table>
            <thead>
              <tr><th>Тип</th><th>Когда использовать</th><th>Пример</th></tr>
            </thead>
            <tbody>
              <tr><td><strong>INT</strong></td><td>Целые числа</td><td>42, 1000</td></tr>
              <tr><td><strong>FLOAT</strong></td><td>Числа с дробью</td><td>3.14, 99.9</td></tr>
              <tr><td><strong>DATE</strong></td><td>Даты</td><td>2024-01-15</td></tr>
              <tr><td><strong>NVARCHAR(255)</strong></td><td>Текст до 255 символов</td><td>ФИО, код</td></tr>
              <tr><td><strong>NVARCHAR(MAX)</strong></td><td>Длинный текст</td><td>Описание</td></tr>
              <tr><td><strong>BIT</strong></td><td>Да / Нет</td><td>1 / 0</td></tr>
            </tbody>
          </table>
        </div>
      </section>
    </div>

    <section class="card" style="margin-bottom:20px;">
      <h2>Режим импорта</h2>
      <div style="display:flex; gap:12px; flex-wrap:wrap; margin-top:12px;">
        <label style="display:flex; align-items:flex-start; gap:10px; padding:14px 18px; border:2px solid var(--border,#ccc); border-radius:8px; cursor:pointer; flex:1; min-width:180px; background:var(--bg,#fff);">
          <input type="radio" name="mode" value="insert" checked style="margin-top:3px; flex-shrink:0;" />
          <div>
            <strong style="display:block; margin-bottom:4px;">INSERT</strong>
            <span class="muted" style="font-size:0.85em;">Добавить новые строки, пропустить дубли</span>
          </div>
        </label>
        <label style="display:flex; align-items:flex-start; gap:10px; padding:14px 18px; border:2px solid var(--border,#ccc); border-radius:8px; cursor:pointer; flex:1; min-width:180px; background:var(--bg,#fff);">
          <input type="radio" name="mode" value="replace" style="margin-top:3px; flex-shrink:0;" />
          <div>
            <strong style="display:block; margin-bottom:4px;">REPLACE</strong>
            <span class="muted" style="font-size:0.85em;">Очистить таблицу и залить заново</span>
          </div>
        </label>
        <label style="display:flex; align-items:flex-start; gap:10px; padding:14px 18px; border:2px solid var(--border,#ccc); border-radius:8px; cursor:pointer; flex:1; min-width:180px; background:var(--bg,#fff);">
          <input type="radio" name="mode" value="upsert" style="margin-top:3px; flex-shrink:0;" />
          <div>
            <strong style="display:block; margin-bottom:4px;">UPSERT</strong>
            <span class="muted" style="font-size:0.85em;">Обновить существующие, добавить новые</span>
          </div>
        </label>
      </div>

      <div id="replace-warning" style="display:none; margin-top:12px; padding:12px 16px; background:#fff3cd; border:1px solid #ffc107; border-radius:6px; color:#856404;">
        <strong>Внимание:</strong> Если таблица уже существует, все её данные будут удалены перед загрузкой. Это действие необратимо.
      </div>

      <div id="upsert-keys" style="display:none; margin-top:14px;">
        <p style="margin-bottom:10px;"><strong>Ключевые столбцы</strong> — по ним система ищет совпадающие записи для обновления:</p>
        <div style="display:flex; flex-wrap:wrap; gap:8px;">
          <% freePreview.columns.forEach((col, i) => { %>
            <label style="display:inline-flex; align-items:center; gap:6px; padding:6px 12px; border:1px solid var(--border,#ccc); border-radius:6px; cursor:pointer; background:var(--bg-alt,#f4f4f4); font-size:0.9em;">
              <input type="checkbox" name="keyColumns" value="<%= i %>" />
              <code id="key-label-<%= i %>"><%= col.safeName %></code>
            </label>
          <% }) %>
        </div>
      </div>
    </section>

    <section class="card" style="margin-bottom:20px;">
      <h2>Схема и примеры данных</h2>
      <p class="muted" style="margin-bottom:16px;">
        Проверьте определённые типы. Первые <%= freePreview.sampleRows.length %> строк показаны как пример.
      </p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th style="min-width:160px;">Колонка (Excel)</th>
              <th style="min-width:160px;">Имя в БД</th>
              <th style="min-width:170px;">Тип данных</th>
              <% freePreview.sampleRows.forEach((_, si) => { %>
                <th>Пример <%= si + 1 %></th>
              <% }) %>
            </tr>
          </thead>
          <tbody>
            <% freePreview.columns.forEach((col, i) => { %>
              <tr>
                <td><strong><%= col.originalName %></strong></td>
                <td>
                  <input
                    type="text"
                    name="col_<%= i %>_name"
                    value="<%= col.safeName %>"
                    class="col-name-input"
                  />
                </td>
                <td>
                  <select name="col_<%= i %>_type" class="type-select">
                    <% ["INT","FLOAT","DATE","NVARCHAR(255)","NVARCHAR(MAX)","BIT"].forEach(t => { %>
                      <option value="<%= t %>" <%= col.inferredType === t ? "selected" : "" %>><%= t %></option>
                    <% }) %>
                  </select>
                </td>
                <% freePreview.sampleRows.forEach(row => { %>
                  <td class="muted" style="font-size:0.9em;">
                    <%= fmtVal(row[col.originalName]) %>
                  </td>
                <% }) %>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>

    <div style="display:flex; gap:12px; align-items:center;">
      <button class="primary-button" type="submit">Импортировать в базу</button>
      <a href="/free-upload?reset=1" style="color:var(--muted);">Отмена — загрузить другой файл</a>
    </div>
  </form>

<% } %>

<script>
  // Custom file button: always clears input before opening picker
  const chooseFileBtn = document.getElementById('chooseFileBtn');
  const excelFileInput = document.getElementById('excelFileInput');
  const excelFileName = document.getElementById('excelFileName');
  if (chooseFileBtn && excelFileInput) {
    chooseFileBtn.addEventListener('click', function() {
      excelFileInput.value = '';
      excelFileName.textContent = 'Файл не выбран';
      excelFileInput.click();
    });
    excelFileInput.addEventListener('change', function() {
      excelFileName.textContent = this.files[0]?.name || 'Файл не выбран';
    });
  }

  // Table name preview
  const suffixInput = document.querySelector('[name="tableNameSuffix"]');
  const tablePreview = document.getElementById('tableNamePreview');
  if (suffixInput && tablePreview) {
    suffixInput.addEventListener('input', () => {
      tablePreview.textContent = 'free_' + suffixInput.value;
    });
  }

  // Mode selector
  const modeRadios = document.querySelectorAll('[name="mode"]');
  const replaceWarning = document.getElementById('replace-warning');
  const upsertKeys = document.getElementById('upsert-keys');

  function updateMode() {
    const mode = document.querySelector('[name="mode"]:checked')?.value;
    if (replaceWarning) replaceWarning.style.display = mode === 'replace' ? 'block' : 'none';
    if (upsertKeys) upsertKeys.style.display = mode === 'upsert' ? 'block' : 'none';
  }

  modeRadios.forEach(r => r.addEventListener('change', updateMode));

  // Keep key column labels in sync with user-edited column names
  document.querySelectorAll('.col-name-input').forEach((inp, i) => {
    const label = document.getElementById('key-label-' + i);
    if (label) {
      inp.addEventListener('input', () => {
        label.textContent = inp.value || ('col_' + i);
      });
    }
  });
</script>
<%- include("partials/footer") %>
