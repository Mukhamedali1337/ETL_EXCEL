<%- include("partials/header", { title: "Загрузка Excel", heading: "Загрузка Excel" }) %>

<section class="hero-grid">
  <div class="card">
    <h2>Выбор типа импорта</h2>
    <p class="muted">Выберите нужный шаблон из списка ниже.</p>
    <div class="template-selector">
      <% templates.forEach((template) => { %>
        <a
          href="/upload?template=<%= template.id %>"
          class="template-pill <%= selectedTemplate && selectedTemplate.id === template.id ? "template-pill-active" : "" %>"
        >
          <span><%= template.name %></span>
          <small><%= template.ready ? "Готов" : "В ожидании" %></small>
        </a>
      <% }) %>
    </div>
  </div>

  <div class="card accent-card">
    <h2><%= selectedTemplate ? selectedTemplate.name : "Тип импорта" %></h2>
    <p class="muted"><%= selectedTemplate ? selectedTemplate.description : "" %></p>

    <h3>Ожидаемые столбцы</h3>
    <div class="template-grid">
      <% if (selectedTemplate && selectedTemplate.columns && selectedTemplate.columns.length > 0) { %>
        <% selectedTemplate.columns.forEach((col) => { %>
          <span><%= col.excelHeader %></span>
        <% }) %>
      <% } else if (selectedTemplate && selectedTemplate.requiredHeaders && selectedTemplate.requiredHeaders.length > 0) { %>
        <% selectedTemplate.requiredHeaders.forEach((header) => { %>
          <span><%= header %></span>
        <% }) %>
      <% } else { %>
        <span>Столбцы будут добавлены позже</span>
      <% } %>
    </div>

    <h3>Правила</h3>
    <ul class="check-list">
      <% if (selectedTemplate && selectedTemplate.rules && selectedTemplate.rules.length > 0) { %>
        <% selectedTemplate.rules.forEach((rule) => { %>
          <li><%= rule %></li>
        <% }) %>
      <% } else { %>
        <li>Правила еще не заданы</li>
      <% } %>
    </ul>
  </div>
</section>

<section class="card">
  <h2>Загрузить файл</h2>
  <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>
  <% if (success) { %>
    <div class="alert alert-success"><%= success %></div>
  <% } %>

  <% if (selectedTemplate && !selectedTemplate.ready) { %>
    <div class="alert">
      Для <strong><%= selectedTemplate.name %></strong> загрузка временно выключена.
    </div>
  <% } %>

  <form method="post" action="/upload" enctype="multipart/form-data" class="form-stack">
    <input type="hidden" name="templateType" value="<%= selectedTemplate ? selectedTemplate.id : "" %>" />
    <label>
      Excel-файл
      <input
        type="file"
        name="excelFile"
        accept=".xlsx,.xls"
        <%= selectedTemplate && !selectedTemplate.ready ? "disabled" : "required" %>
      />
    </label>
    <button class="primary-button" type="submit" <%= selectedTemplate && !selectedTemplate.ready ? "disabled" : "" %>>
      Проверить файл
    </button>
  </form>
</section>

<% if (preview) { %>

  <% if (preview.isNewTemplate) { %>
    <%# ── Новый шаблон ── %>
    <section class="preview-grid">
      <div class="card">
        <h2>Предпросмотр импорта</h2>
        <div class="stats-grid">
          <div class="stat-box">
            <strong><%= preview.originalFileName %></strong>
            <span>Файл</span>
          </div>
          <div class="stat-box">
            <strong><%= preview.templateName %></strong>
            <span>Шаблон</span>
          </div>
          <div class="stat-box">
            <strong><%= preview.totalRows %></strong>
            <span>Строк в файле</span>
          </div>
          <div class="stat-box">
            <strong><%= preview.validRows.length %></strong>
            <span>Готово к загрузке</span>
          </div>
          <div class="stat-box">
            <strong><%= preview.errors.length %></strong>
            <span>Пропущено (дубли)</span>
          </div>
        </div>
        <p class="muted" style="margin-top:16px; font-size:0.85em;">Выберите режим импорта ниже и нажмите «Импортировать».</p>
      </div>

      <div class="card">
        <h2>Пример данных (первые <%= preview.sampleRows.length %> строк)</h2>
        <% if (preview.sampleRows.length === 0) { %>
          <p class="muted">Нет строк для отображения.</p>
        <% } else { %>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <% preview.columns.forEach(col => { %><th><%= col.excelHeader %></th><% }) %>
                </tr>
              </thead>
              <tbody>
                <% preview.sampleRows.forEach(row => { %>
                  <tr>
                    <% preview.columns.forEach(col => { %>
                      <td class="muted" style="font-size:0.9em; max-width:160px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                        <%= fmtVal(row[col.sqlName]) %>
                      </td>
                    <% }) %>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </section>

    <% if (preview.errors.length > 0) { %>
      <section class="card">
        <h2>Пропущенные строки (<%= preview.errors.length %>)</h2>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Строка</th><th>Причина</th></tr></thead>
            <tbody>
              <% preview.errors.forEach(e => { %>
                <tr>
                  <td><%= e.rowNumber %></td>
                  <td class="muted"><%= e.message %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </section>
    <% } %>

  <form method="post" action="/import">
    <section class="card" style="margin-bottom:20px;">
      <h2>Режим импорта</h2>
      <div style="display:flex; gap:12px; flex-wrap:wrap; margin-top:12px;">
        <label style="display:flex; align-items:flex-start; gap:10px; padding:14px 18px; border:2px solid var(--border,#ccc); border-radius:8px; cursor:pointer; flex:1; min-width:180px; background:var(--bg,#fff);">
          <input type="radio" name="mode" value="insert" checked style="margin-top:3px; flex-shrink:0;" />
          <div>
            <strong style="display:block; margin-bottom:4px;">INSERT</strong>
            <span class="muted" style="font-size:0.85em;">Добавить новые строки, пропустить дубли</span>
          </div>
        </label>
        <label style="display:flex; align-items:flex-start; gap:10px; padding:14px 18px; border:2px solid var(--border,#ccc); border-radius:8px; cursor:pointer; flex:1; min-width:180px; background:var(--bg,#fff);">
          <input type="radio" name="mode" value="replace" style="margin-top:3px; flex-shrink:0;" />
          <div>
            <strong style="display:block; margin-bottom:4px;">REPLACE</strong>
            <span class="muted" style="font-size:0.85em;">Очистить таблицу и залить заново</span>
          </div>
        </label>
        <label style="display:flex; align-items:flex-start; gap:10px; padding:14px 18px; border:2px solid var(--border,#ccc); border-radius:8px; cursor:pointer; flex:1; min-width:180px; background:var(--bg,#fff);">
          <input type="radio" name="mode" value="upsert" style="margin-top:3px; flex-shrink:0;" />
          <div>
            <strong style="display:block; margin-bottom:4px;">UPSERT</strong>
            <span class="muted" style="font-size:0.85em;">Обновить существующие, добавить новые</span>
          </div>
        </label>
      </div>

      <div id="import-replace-warning" style="display:none; margin-top:12px; padding:12px 16px; background:#fff3cd; border:1px solid #ffc107; border-radius:6px; color:#856404;">
        <strong>Внимание:</strong> Если таблица уже содержит данные, все они будут удалены перед загрузкой. Это действие необратимо.
      </div>

      <div id="import-upsert-keys" style="display:none; margin-top:14px;">
        <p style="margin-bottom:10px;"><strong>Ключевые столбцы</strong> — по ним система ищет совпадающие записи для обновления:</p>
        <div style="display:flex; flex-wrap:wrap; gap:8px;">
          <% preview.columns.forEach((col) => { %>
            <label style="display:inline-flex; align-items:center; gap:6px; padding:6px 12px; border:1px solid var(--border,#ccc); border-radius:6px; cursor:pointer; background:var(--bg-alt,#f4f4f4); font-size:0.9em;">
              <input type="checkbox" name="keyColumns" value="<%= col.sqlName %>" />
              <code><%= col.excelHeader %></code>
            </label>
          <% }) %>
        </div>
      </div>
    </section>

    <div style="display:flex; gap:12px; align-items:center; margin-bottom:32px;">
      <button class="primary-button" type="submit" <%= preview.validRows.length === 0 ? "disabled" : "" %>>Импортировать в базу</button>
      <a href="/upload?template=<%= preview.templateType %>&reset=1" style="color:var(--muted);">Отмена — загрузить другой файл</a>
    </div>
  </form>

  <% } else { %>
    <%# ── Старый шаблон training_records ── %>
    <section class="preview-grid">
      <div class="card">
        <h2>Предпросмотр импорта</h2>
        <div class="stats-grid">
          <div class="stat-box">
            <strong><%= preview.originalFileName %></strong>
            <span>Файл</span>
          </div>
          <div class="stat-box">
            <strong><%= preview.templateName || "Не указан" %></strong>
            <span>Тип импорта</span>
          </div>
          <div class="stat-box">
            <strong><%= preview.totalRows %></strong>
            <span>Всего строк</span>
          </div>
          <div class="stat-box">
            <strong><%= preview.validRows.length %></strong>
            <span>Валидных строк</span>
          </div>
          <div class="stat-box">
            <strong><%= preview.errors.length %></strong>
            <span>Ошибок</span>
          </div>
        </div>
        <form method="post" action="/import">
          <button class="primary-button" type="submit" <%= preview.validRows.length === 0 ? "disabled" : "" %>>
            Подтвердить импорт
          </button>
        </form>
      </div>

      <div class="card">
        <h2>Валидные строки</h2>
        <% if (preview.validRows.length === 0) { %>
          <p class="muted">Нет строк, готовых к импорту.</p>
        <% } else { %>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>employee_id</th><th>full_name</th><th>email</th>
                  <th>course_code</th><th>course_name</th><th>completion_date</th><th>score</th>
                </tr>
              </thead>
              <tbody>
                <% preview.validRows.slice(0, 20).forEach((row) => { %>
                  <tr>
                    <td><%= row.employee_id %></td>
                    <td><%= row.full_name %></td>
                    <td><%= row.email %></td>
                    <td><%= row.course_code %></td>
                    <td><%= row.course_name %></td>
                    <td><%= row.completion_date %></td>
                    <td><%= row.score %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </section>

    <section class="card">
      <h2>Ошибки проверки</h2>
      <% if (preview.errors.length === 0) { %>
        <div class="alert alert-success">Ошибок не найдено.</div>
      <% } else { %>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Строка</th><th>Поле</th><th>Ошибка</th></tr></thead>
            <tbody>
              <% preview.errors.forEach((errorItem) => { %>
                <tr>
                  <td><%= errorItem.rowNumber %></td>
                  <td><%= errorItem.field %></td>
                  <td><%= errorItem.message %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>
  <% } %>

<% } %>

<script>
  const modeRadios = document.querySelectorAll('[name="mode"]');
  const replaceWarn = document.getElementById('import-replace-warning');
  const upsertKeys  = document.getElementById('import-upsert-keys');
  function updateImportMode() {
    const mode = document.querySelector('[name="mode"]:checked')?.value;
    if (replaceWarn) replaceWarn.style.display = mode === 'replace' ? 'block' : 'none';
    if (upsertKeys)  upsertKeys.style.display  = mode === 'upsert'  ? 'block' : 'none';
  }
  modeRadios.forEach(r => r.addEventListener('change', updateImportMode));
</script>
<%- include("partials/footer") %>
